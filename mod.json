{
  "geode": "5.0.0",7
  "gd": {
    "win": "2.2081",
    "android": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "ragday68.simple-mod-menu",
  "name": "Simple Mod Menu",
  "version": "v1.0.0",
  "developer": "ragday68",
  "description": "Простое мод-меню: кнопка в главном меню, ноуклип и скорость игры.",
  "dependencies": {
    "geode.node-ids": ">=v1.22.0"
  },
  "settings": {
    "noclip": {
      "type": "bool",
      "name": "Noclip",
      "description": "Не умирать от препятствий. Прогресс не сохраняется.",
      "default": false
    },
    "speed": {
      "type": "float",
      "name": "Скорость игры",
      "description": "1.0 = обычная. Прогресс не сохраняется.",
      "default": 1.0,
      "min": 0.1,
      "max": 3.0,
      "control": {
        "slider": true
      }
    }
  }
}

